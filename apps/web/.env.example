# Environment variables example
# Copy this file to .env.local and update the values as needed.
# Local-only, single-user build: every variable is optional.

# Node
NODE_ENV=development

# Public (keep it exactly http://localhost:3456: projects live in this origin's IndexedDB/OPFS)
NEXT_PUBLIC_SITE_URL=http://localhost:3456

# Freesound sound search (optional; the Sounds tab shows a notice without a key)
FREESOUND_API_KEY=
